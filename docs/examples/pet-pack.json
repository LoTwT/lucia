{
  "schema": 1,
  "id": "example",
  "name": "示例桌宠",
  "license": {
    "status": "CC BY-NC-SA 4.0",
    "note": "示例元数据；随包分发时必须替换为素材的真实授权信息。"
  },
  "canvas": { "width": 800, "height": 800 },
  "crop": { "x": 0, "y": 0, "width": 800, "height": 800 },
  "base": {
    "window": { "width": 248, "height": 310 },
    "sprite": { "width": 240, "height": 300 },
    "margin": 4
  },
  "bubbleAnchor": { "x": 0.5, "y": 0.05 },
  "clips": {
    "idle_loop": { "file": "clips/idle_loop.webp", "frames": 4, "loop": true },
    "happy_enter": { "file": "clips/happy_enter.webp", "frames": 3 },
    "happy_exit": { "file": "clips/happy_exit.webp", "frames": 2 },
    "laugh_enter": { "file": "clips/laugh_enter.webp", "frames": 3 },
    "laugh_exit": { "file": "clips/laugh_exit.webp", "frames": 2 },
    "wave": { "file": "clips/wave.webp", "frames": 6 },
    "think": { "file": "clips/think.webp", "frames": 4 },
    "sad": { "file": "clips/sad.webp", "frames": 4 },
    "belly_taunt": { "file": "clips/belly_taunt.webp", "frames": 8 }
  },
  "actions": {
    "idle": {
      "label": "待机",
      "loop": "idle_loop",
      "poster": "idle_loop#0",
      "loopCount": -1,
      "interruptible": true
    },
    "happy": {
      "label": "开心",
      "enter": "happy_enter",
      "exit": "happy_exit",
      "poster": "happy_enter#0"
    },
    "laugh": {
      "label": "大笑",
      "enter": "laugh_enter",
      "exit": "laugh_exit",
      "poster": "laugh_enter#0"
    },
    "wave": { "label": "挥手", "once": "wave", "poster": "wave#0" },
    "think": { "label": "思考", "once": "think", "poster": "think#0" },
    "sad": { "label": "难过", "once": "sad", "poster": "sad#0" },
    "belly_taunt": { "label": "肚肚挑衅", "once": "belly_taunt", "poster": "belly_taunt#0" }
  },
  "states": {
    "idle": "idle"
  },
  "events": {
    "intro": "wave",
    "activate": "wave",
    "reset": "wave",
    "update.checking": "think",
    "update.failed": "sad"
  },
  "hotzones": [
    {
      "id": "face",
      "label": "摸摸脸",
      "rect": { "x": 0.3, "y": 0.45, "width": 0.4, "height": 0.3 },
      "interaction": "poke"
    },
    {
      "id": "head",
      "label": "摸摸头",
      "rect": { "x": 0.2, "y": 0.1, "width": 0.6, "height": 0.2 },
      "interaction": "pat"
    }
  ],
  "interactions": {
    "poke": {
      "label": "摸摸脸",
      "steps": [{ "action": "laugh" }],
      "bubble": "face",
      "sound": true
    },
    "pat": {
      "label": "摸摸头",
      "steps": [{ "action": "happy" }],
      "bubble": "pat",
      "sound": true
    }
  },
  "bubbles": {
    "face": ["别戳脸啦……", "脸要变形了。"],
    "pat": ["摸头……还行吧。", "再摸一下也可以。"]
  },
  "menu": [
    { "interaction": "pat" },
    { "action": "belly_taunt" }
  ],
  "idleMotion": "none"
}
